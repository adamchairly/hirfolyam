{
  "Database": {
    "MigrateOnStartup": true
  },
  "Import": {
    "LookbackHours": 48
  },
  "HotTopics": {
    "ArticleCount": 100,
    "TopicCount": 5,
    "MaxAgeHours": 3
  },
  "OpenRouter": {
    "HotTopics": {
      "Model": "openai/gpt-6-luna",
      "ReasoningEffort": "low",
      "TimeoutSeconds": 120
    }
  },
  "Jobs": {
    "Import": {
      "Enabled": true,
      "RunOnStartup": true,
      "CronExpression": "0 0/5 * * * ?"
    },
    "HotTopics": {
      "Enabled": true,
      "RunOnStartup": true,
      "CronExpression": "0 2 * * * ?"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Polly": "Warning",
        "Quartz": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
